publish/

################################################################################
# ASP.NET Core specifics
################################################################################
# User secrets (stored outside repo by default, but just in case)
secrets.json

# Kestrel dev certs (don’t commit machine certs)
*.pfx
*.p12

# Configuration overrides
appsettings.*.local.json

################################################################################
# Package / Dependency Managers
################################################################################
# NuGet
*.nupkg
*.snupkg
# Lock file is usually committed; ignore only if your team prefers not to
# packages/

# LibMan (keep libman.json, but ignore caches)
libman.cache/

# npm / yarn / pnpm (if you wire a front-end build)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml
package-lock.json
# If you commit lockfiles for determinism, remove the ignore above.

################################################################################
# Coverage / Analysis
################################################################################
coverage/
.coverage
*.coverage
*.coveragexml
.coverlet/
TestResults/

################################################################################
# Local secrets / compose overrides
################################################################################
.env
docker-compose.override.yml

################################################################################
# Misc tools / caches
################################################################################
# Resharper / DotCover / etc.
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# Tye
.tye/

# Temporary files
tmp/
temp/

################################################################################
# Logs & runtime artifacts
################################################################################
*.log
*.log.*
*.trace
*.etl
*.db
*/appsettings.Development.json

