fairshare.db
FairShare.db


################################################################################
# AI DLC Documentation (Private)
################################################################################
aidlc-docs/


# design-system package (React design-time twins; see design-system/README.md)
design-system/node_modules/
design-system/dist/

# Rendered SEO snapshots are build artifacts (CI renders fresh ones per build)
snapshots/*
!snapshots/.gitkeep

# design-sync working state (converter scripts, build output, machine caches)
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
