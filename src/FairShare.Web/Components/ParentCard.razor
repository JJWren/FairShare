@using FairShare.Contracts.Calculation
@using FairShare.Contracts.Parents
@inject NavigationManager Navigation

<div class="col-12 col-lg-6">
    <div class="card h-100 shadow-sm fs-party-card @PartyClass">
        <div class="card-header text-center d-flex flex-column gap-2">
            <div class="d-flex justify-content-between align-items-center">
                <span class="badge fs-party-badge">@Title</span>
                @if (ShowPrimary)
                {
                    <div class="form-check form-switch m-0">
                        <input type="checkbox"
                               checked="@Data.HasPrimaryCustody"
                               @onchange="OnPrimaryChanged"
                               class="form-check-input"
                               id="@($"{Prefix}_Primary")" />
                        <label class="form-check-label small" for="@($"{Prefix}_Primary")">Primary Custody</label>
                    </div>
                }
            </div>
            <div class="d-flex gap-2 align-items-start">
                <select class="form-select form-select-sm"
                        value="@(SelectedProfileId ?? string.Empty)"
                        @onchange="OnParentSelected"
                        disabled="@IsGuest"
                        aria-label="Select saved parent to populate @Title fields"
                        aria-describedby="@(IsGuest ? $"{Prefix}_SavedParentsHint" : null)">
                    <option value="">-- Select saved parent --</option>
                    @if (SavedProfiles != null)
                    {
                        @foreach (var p in SavedProfiles)
                        {
                            <option value="@p.Id">@p.DisplayName ($@p.MonthlyGrossIncome)</option>
                        }
                    }
                </select>
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        @onclick="ClearData"
                        title="Clear populated values">
                    Clear
                </button>
            </div>
            @if (IsGuest)
            {
                @* The disabled picker advertises the account feature; the hint is tied to it via
                   aria-describedby so screen readers hear why it is disabled, not just that it is. *@
                <div id="@($"{Prefix}_SavedParentsHint")" class="form-text m-0">
                    <a href="@SignInHref">Sign in</a> to save parents and reuse them here.
                </div>
            }
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label" for="@($"{Prefix}_Name")">Name (optional)</label>
                <input type="text"
                       class="form-control"
                       id="@($"{Prefix}_Name")"
                       value="@ParentName"
                       @onchange="OnNameChanged"
                       maxlength="100"
                       placeholder="e.g. John D." />
            </div>
            <div class="mb-3">
                <label class="form-label" for="@($"{Prefix}_Income")">Monthly Gross Income</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="@($"{Prefix}_Income")" @bind="Income" class="form-control" min="0" step="1" inputmode="numeric" placeholder="0" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="@($"{Prefix}_Support")">Pre-existing Child Support</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="@($"{Prefix}_Support")" @bind="Support" class="form-control" min="0" step="1" inputmode="numeric" placeholder="0" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="@($"{Prefix}_Alimony")">Pre-existing Alimony</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="@($"{Prefix}_Alimony")" @bind="Alimony" class="form-control" min="0" step="1" inputmode="numeric" placeholder="0" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label" for="@($"{Prefix}_Childcare")">Work-related Childcare Costs</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="@($"{Prefix}_Childcare")" @bind="Childcare" class="form-control" min="0" step="1" inputmode="numeric" placeholder="0" />
                </div>
            </div>
            <div class="mb-0">
                <label class="form-label" for="@($"{Prefix}_Healthcare")">Healthcare Coverage Costs</label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input type="number" id="@($"{Prefix}_Healthcare")" @bind="Healthcare" class="form-control" min="0" step="1" inputmode="numeric" placeholder="0" />
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Prefix { get; set; } = string.Empty;
    [Parameter] public ParentDataDto Data { get; set; } = new();
    [Parameter] public string? ParentName { get; set; }
    [Parameter] public EventCallback<string?> ParentNameChanged { get; set; }
    [Parameter] public bool ShowPrimary { get; set; }

    /// <summary>
    /// Raised only when the user flips the Primary Custody switch (not when a saved profile or Clear
    /// writes the flag), so the page can mirror the choice onto the other parent.
    /// </summary>
    [Parameter] public EventCallback<bool> OnPrimaryCustodyChanged { get; set; }
    [Parameter] public IEnumerable<ParentProfileDto>? SavedProfiles { get; set; }
    [Parameter] public EventCallback<ParentProfileDto?> OnProfileSelected { get; set; }

    /// <summary>
    /// Guests cannot save parents, so the picker is disabled with a sign-in hint instead
    /// of rendering as an inexplicably empty list.
    /// </summary>
    [Parameter] public bool IsGuest { get; set; }

    /// <summary>
    /// The picker's selection, owned by the page so a page-level Reset can clear the
    /// dropdown too (an unbound select would keep showing the last-chosen name).
    /// </summary>
    [Parameter] public string? SelectedProfileId { get; set; }
    [Parameter] public EventCallback<string?> SelectedProfileIdChanged { get; set; }

    // Nullable proxies over the int DTO fields so empty fields render EMPTY instead of a
    // prefilled 0 the user must select-and-delete ("05000" typos). Empty means 0 at
    // calculate time; the DTO wire shape is unchanged. inputmode=numeric on the inputs
    // brings up the number pad on phones.
    //
    // The visible values are component state, not derived from the DTO per render: deriving
    // null from 0 every render made an explicitly typed 0 vanish from the field on the next
    // render. They re-derive only when a DIFFERENT DTO instance is bound (page reset, stash
    // restore), a saved profile is applied, or Clear runs - a stored 0 renders empty there
    // by design.
    private int? _income, _support, _alimony, _childcare, _healthcare;
    private ParentDataDto? _syncedData;

    private int? Income { get => _income; set { _income = value; Data.MonthlyGrossIncome = value ?? 0; } }
    private int? Support { get => _support; set { _support = value; Data.PreexistingChildSupport = value ?? 0; } }
    private int? Alimony { get => _alimony; set { _alimony = value; Data.PreexistingAlimony = value ?? 0; } }
    private int? Childcare { get => _childcare; set { _childcare = value; Data.WorkRelatedChildcareCosts = value ?? 0; } }
    private int? Healthcare { get => _healthcare; set { _healthcare = value; Data.HealthcareCoverageCosts = value ?? 0; } }

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_syncedData, Data))
        {
            _syncedData = Data;
            SyncFieldsFromData();
        }
    }

    private void SyncFieldsFromData()
    {
        _income = Data.MonthlyGrossIncome == 0 ? null : Data.MonthlyGrossIncome;
        _support = Data.PreexistingChildSupport == 0 ? null : Data.PreexistingChildSupport;
        _alimony = Data.PreexistingAlimony == 0 ? null : Data.PreexistingAlimony;
        _childcare = Data.WorkRelatedChildcareCosts == 0 ? null : Data.WorkRelatedChildcareCosts;
        _healthcare = Data.HealthcareCoverageCosts == 0 ? null : Data.HealthcareCoverageCosts;
    }

    private string SignInHref =>
        $"login?returnUrl={Uri.EscapeDataString("/" + Navigation.ToBaseRelativePath(Navigation.Uri))}";

    // Prefix is the party identity ("Plaintiff"/"Defendant"); the class picks that
    // party's accent tokens in app.css.
    private string PartyClass => $"fs-party-{Prefix.ToLowerInvariant()}";

    private async Task OnPrimaryChanged(ChangeEventArgs e)
    {
        // Blazor supplies a bool for checkboxes; accept a "true"/"false" string too so this can't silently stick off.
        Data.HasPrimaryCustody = e.Value switch
        {
            bool flag => flag,
            string text => bool.TryParse(text, out bool parsed) && parsed,
            _ => false
        };
        await OnPrimaryCustodyChanged.InvokeAsync(Data.HasPrimaryCustody);
    }

    private async Task OnNameChanged(ChangeEventArgs e)
    {
        ParentName = e.Value?.ToString();
        await ParentNameChanged.InvokeAsync(ParentName);
    }

    private async Task OnParentSelected(ChangeEventArgs e)
    {
        var idString = e.Value?.ToString();

        SelectedProfileId = idString;
        await SelectedProfileIdChanged.InvokeAsync(idString);

        if (Guid.TryParse(idString, out var id))
        {
            var profile = SavedProfiles?.FirstOrDefault(p => p.Id == id);

            if (profile != null)
            {
                Data.MonthlyGrossIncome = profile.MonthlyGrossIncome;
                Data.PreexistingChildSupport = profile.PreexistingChildSupport;
                Data.PreexistingAlimony = profile.PreexistingAlimony;
                Data.WorkRelatedChildcareCosts = profile.WorkRelatedChildcareCosts;
                Data.HealthcareCoverageCosts = profile.HealthcareCoverageCosts;
                Data.HasPrimaryCustody = profile.HasPrimaryCustody;
                SyncFieldsFromData();

                ParentName = profile.DisplayName;
                await ParentNameChanged.InvokeAsync(ParentName);
                await OnProfileSelected.InvokeAsync(profile);
            }
        }
        else
        {
            await OnProfileSelected.InvokeAsync(null);
        }
    }

    private async Task ClearData()
    {
        SelectedProfileId = string.Empty;
        await SelectedProfileIdChanged.InvokeAsync(SelectedProfileId);

        Data.MonthlyGrossIncome = 0;
        Data.PreexistingChildSupport = 0;
        Data.PreexistingAlimony = 0;
        Data.WorkRelatedChildcareCosts = 0;
        Data.HealthcareCoverageCosts = 0;
        Data.HasPrimaryCustody = false;
        SyncFieldsFromData();

        ParentName = string.Empty;
        await ParentNameChanged.InvokeAsync(ParentName);
        await OnProfileSelected.InvokeAsync(null);
    }
}
