@page "/States/{State}/{Form?}"
@attribute [Authorize]
@implements IDisposable
@using FairShare.Contracts.Calculation
@using FairShare.Contracts.Catalog
@using FairShare.Contracts.Parents
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject FairShare.Web.Services.AnalyticsBeacon Beacon

<PageTitle>FairShare - @State - @(CurrentForm?.DisplayName ?? Form) Calculator</PageTitle>

<div class="container my-4">
    <h1 class="h4 mb-3 text-center">@State - @(CurrentForm?.DisplayName ?? Form) Calculator</h1>

    @if (forms is null)
    {
        <p class="text-center text-muted">Loading forms...</p>
    }
    else if (!forms.Any())
    {
        <div class="alert alert-warning">No forms registered for this state.</div>
    }
    else
    {
        @* Plain navigation pills (each is a real link to the form's route), not a tab widget - so no tab roles.
           Manual active class on purpose: NavLink's prefix match would light up CS42 while on CS42S. *@
        <nav aria-label="Select form">
            <ul class="nav nav-pills nav-fill justify-content-center mb-2">
                @foreach (var f in forms)
                {
                    bool active = f.Form.Equals(Form, StringComparison.OrdinalIgnoreCase);
                    <li class="nav-item">
                        <a class="nav-link @(active ? "active" : "")"
                           aria-current="@(active ? "page" : null)"
                           href="@($"/States/{State}/{f.Form}")">@f.DisplayName</a>
                    </li>
                }
            </ul>
        </nav>
        @if (!string.IsNullOrWhiteSpace(CurrentForm?.Description))
        {
            <p class="text-muted small text-center mb-4">@CurrentForm.Description</p>
        }
    }

    @if (IsOregonState)
    {
        @* Oregon's inputs don't fit the classic two-parents-plus-child-count surface below; the
           state's whole form lives in its own component. *@
        <OregonWorksheet State="@State" Form="@(Form ?? string.Empty)" IsGuest="isGuest" />
    }
    else
    {
    <div class="row g-3 mb-4 justify-content-center">
        <div class="col-12 col-sm-5 col-lg-3 text-center">
            <label class="form-label" for="NumberOfChildren">Number of Children</label>
            @* The schedule covers exactly 1-6 children (BcsoLookup.MinChildren/MaxChildren);
               the old free number input defaulted to 0 and let 7+ through, both only to be
               rejected at Calculate time. *@
            <select id="NumberOfChildren" @bind="numberOfChildren" class="form-select" aria-describedby="NumberOfChildrenHelp">
                @for (int children = 1; children <= 6; children++)
                {
                    <option value="@children">@children</option>
                }
            </select>
            <div id="NumberOfChildrenHelp" class="form-text">
                The schedule covers up to 6 children; beyond that, support is at the court's discretion.
            </div>
        </div>
    </div>

    @if (RequiresPrimaryCustody)
    {
        <div class="alert alert-info py-2 small text-center">
            Mark exactly one parent as having Primary Custody.
        </div>
    }

    @if (showImportPrompt)
    {
        @* The conversion moment (ADR 0004): a guest's work followed them through sign-in;
           nothing is saved without an explicit yes. *@
        <div class="alert alert-success d-flex align-items-center justify-content-between flex-wrap gap-2" role="alert">
            <span>Welcome back - your figures came with you. Save these parents to your account?</span>
            <span class="d-flex gap-2">
                <button class="btn btn-sm btn-success" @onclick="ImportStashAsync">Save to my account</button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => showImportPrompt = false">Not now</button>
            </span>
        </div>
    }

    @if (!string.IsNullOrEmpty(Form))
    {
        <ScenarioBar State="@State" Form="@Form" IsGuest="isGuest"
                     GetInputs="BuildScenarioInputs" OnLoaded="ApplyScenarioAsync" />
    }

    <div class="row g-4">
        <ParentCard Title="Plaintiff"
                    Prefix="Plaintiff"
                    Data="plaintiff"
                    @bind-ParentName="plaintiffName"
                    ShowPrimary="RequiresPrimaryCustody"
                    OnPrimaryCustodyChanged="value => MirrorPrimaryCustody(defendant, value)"
                    SavedProfiles="savedProfiles"
                    IsGuest="isGuest"
                    @bind-SelectedProfileId="plaintiffSelectedProfileId" />

        <ParentCard Title="Defendant"
                    Prefix="Defendant"
                    Data="defendant"
                    @bind-ParentName="defendantName"
                    ShowPrimary="RequiresPrimaryCustody"
                    OnPrimaryCustodyChanged="value => MirrorPrimaryCustody(plaintiff, value)"
                    SavedProfiles="savedProfiles"
                    IsGuest="isGuest"
                    @bind-SelectedProfileId="defendantSelectedProfileId" />
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="() => CalculateAsync()" disabled="@calculating">Calculate</button>
        <button class="btn btn-outline-danger" @onclick="ResetAsync">Reset</button>
        <button class="btn btn-outline-success ms-auto d-inline-flex align-items-center gap-2"
                @onclick="ExportAsync"
                disabled="@(exporting || !CanExport)"
                aria-label="Export to Excel"
                title="Download the official Excel worksheet with these figures filled in">
            @if (exporting)
            {
                <span>Preparing...</span>
            }
            else
            {
                @* Inline spreadsheet glyph (currentColor follows the button/theme); one icon
                   does not justify vendoring an icon library into the WASM payload. *@
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"
                     fill="currentColor" fill-rule="evenodd" aria-hidden="true" focusable="false">
                    <path d="M2.5 2h11a.5.5 0 0 1 .5.5v11a.5.5 0 0 1-.5.5h-11a.5.5 0 0 1-.5-.5v-11a.5.5 0 0 1 .5-.5zM3 3v2h10V3H3zm0 3v3h4.5V6H3zm5.5 0v3H13V6H8.5zM3 10v3h4.5v-3H3zm5.5 0v3H13v-3H8.5z"/>
                </svg>
                <span>Export</span>
            }
        </button>
    </div>

    @if (errors.Any())
    {
        <div class="mt-3" role="alert">
            <ul class="text-danger">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="mt-5">
        <div class="card shadow-sm fs-results-card">
            <div class="card-header text-center"><strong>Results</strong></div>
            @* aria-live so screen-reader users hear the outcome (or the failure) they asked
               for - results used to appear silently. *@
            <div class="card-body" aria-live="polite">
                @if (submitted && result is not null && result.Success)
                {
                    <p class="fw-bold text-center mb-0">@ResultSentence(result)</p>

                    @if (result.Lines.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-striped mb-0 worksheet-table">
                                <caption class="visually-hidden">@(CurrentForm?.DisplayName ?? Form) worksheet lines</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Line</th>
                                        <th scope="col">Item</th>
                                        <th scope="col" class="text-end">Plaintiff</th>
                                        <th scope="col" class="text-end">Defendant</th>
                                        <th scope="col" class="text-end">Combined</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in result.Lines)
                                    {
                                        <tr class="@(IsFinalLine(line) ? "fs-row-recommended-order fw-bold" : "")">
                                            <th scope="row" class="fw-normal text-start">@line.Number</th>
                                            <td>@line.Label</td>
                                            <td class="text-end">@FormatCell(line, line.Plaintiff)</td>
                                            <td class="text-end">@FormatCell(line, line.Defendant)</td>
                                            <td class="text-end">@FormatCell(line, line.Combined)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (submitted && result is not null && !result.Success)
                {
                    <ul class="text-danger mb-0">
                        @foreach (var e in result.Errors)
                        {
                            <li>@e.Code: @e.Message</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Enter inputs and Calculate.</p>
                }
            </div>
        </div>
        <p class="text-muted small text-center mt-2 mb-0">
            FairShare provides estimates for informational purposes only - not legal advice.
            Actual support obligations are determined by the court under your state's
            guidelines. See the <a href="/terms">terms</a>.
        </p>
    </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-link">&larr; Back to States</a>
    </div>
</div>

@code {
    [Parameter] public string State { get; set; } = string.Empty;
    [Parameter] public string? Form { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }

    // 1 is the floor of the schedule's 1-6 range and the reason anyone opens the app;
    // Reset returns here too (0 was an invalid state the dropdown cannot even express).
    private int numberOfChildren = 1;
    private readonly ParentDataDto plaintiff = new();
    private readonly ParentDataDto defendant = new();
    private string? plaintiffName;
    private string? defendantName;
    private string? plaintiffSelectedProfileId;
    private string? defendantSelectedProfileId;
    private bool isGuest;
    private CalculationResponse? result;
    private bool submitted;
    private bool calculating;
    private bool exporting;
    private List<ParentProfileDto>? savedProfiles;
    private readonly List<string> errors = new();

    private List<FormSummaryDto>? forms;
    private string? formsLoadedForState;
    private string? activeForm;
    private string? activeState;

    private const string ApiUnreachableMessage = "The FairShare API could not be reached. Check your connection and try again.";
    private const string StaleClientMessage = "Your browser is running an older version of FairShare - reload the page (Ctrl+F5) and try again.";

    private FormSummaryDto? CurrentForm =>
        forms?.FirstOrDefault(f => f.Form.Equals(Form, StringComparison.OrdinalIgnoreCase));

    // Export follows a successful calculation (and recalculates again right before exporting, see ExportAsync).
    private bool CanExport => submitted && result is { Success: true };

    // Until the catalog answers we show no custody requirement rather than guessing from a
    // hardcoded form name — shared UI carries no state or form specifics (ADR 0005).
    private bool RequiresPrimaryCustody =>
        CurrentForm is { } current && !current.IsSharedCustody;

    // The one place the shared page names a state: routing to that state's own input component.
    private bool IsOregonState => State.Equals("OR", StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            AuthenticationState authState = await AuthStateTask;
            isGuest = authState.User.HasClaim(c => c.Type == "guest" && c.Value == "true");
        }

        // Guests have no saved parents by definition - the picker is disabled for them,
        // so don't bother the API for the empty list it would return.
        if (!isGuest)
        {
            await LoadSavedProfilesAsync();
        }

        await RestoreStashAsync();
    }

    // ---- Sign-in stash (ADR 0004): work survives the round-trip through /login ------
    // Dispose writes the in-progress figures to sessionStorage whenever the visitor leaves
    // this page (heading to the login page, and from there possibly through the Google
    // redirect); the next visit restores them. The stash never leaves the browser.

    private const string StashKey = "fairshare-signin-stash";
    private bool showImportPrompt;

    public void Dispose()
    {
        if (!HasEnteredData || JS is not IJSInProcessRuntime syncJs)
        {
            return;
        }

        try
        {
            SignInStash stash = new()
            {
                NumberOfChildren = numberOfChildren,
                Plaintiff = plaintiff,
                Defendant = defendant,
                PlaintiffName = plaintiffName,
                DefendantName = defendantName
            };

            syncJs.InvokeVoid("sessionStorage.setItem", StashKey, System.Text.Json.JsonSerializer.Serialize(stash));
        }
        catch (Exception)
        {
            // Losing the stash only costs convenience; leaving the page must never fail.
        }
    }

    private async Task RestoreStashAsync()
    {
        try
        {
            string? json = await JS.InvokeAsync<string?>("sessionStorage.getItem", StashKey);

            if (string.IsNullOrEmpty(json))
            {
                return;
            }

            await JS.InvokeVoidAsync("sessionStorage.removeItem", StashKey);

            SignInStash? stash = System.Text.Json.JsonSerializer.Deserialize<SignInStash>(json);

            if (stash is null)
            {
                return;
            }

            numberOfChildren = stash.NumberOfChildren is >= 1 and <= 6 ? stash.NumberOfChildren : 1;
            plaintiff.ApplyFrom(stash.Plaintiff);
            defendant.ApplyFrom(stash.Defendant);
            plaintiffName = stash.PlaintiffName;
            defendantName = stash.DefendantName;

            // The explicit yes/no is the point: a signed-in user with named parents gets
            // asked; nothing is written without the answer (fires on every sign-in, not
            // just the first).
            showImportPrompt = !isGuest
                && (!string.IsNullOrWhiteSpace(plaintiffName) || !string.IsNullOrWhiteSpace(defendantName));
        }
        catch (Exception)
        {
            // A corrupt or unreadable stash is discarded silently.
        }
    }

    private async Task ImportStashAsync()
    {
        showImportPrompt = false;
        await SaveParentsAsync();
        await Beacon.TrackEventAsync("guest-work-imported", target: null);
    }

    private sealed class SignInStash
    {
        public int NumberOfChildren { get; set; } = 1;
        public ParentDataDto Plaintiff { get; set; } = new();
        public ParentDataDto Defendant { get; set; } = new();
        public string? PlaintiffName { get; set; }
        public string? DefendantName { get; set; }
    }

    // Switching forms navigates between URLs that resolve to this same component, so Blazor reuses the
    // instance and only this hook runs: the entered figures survive, and we decide what to do with the result.
    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(formsLoadedForState, State, StringComparison.OrdinalIgnoreCase))
        {
            formsLoadedForState = State;
            await LoadFormsAsync();
        }

        if (string.IsNullOrEmpty(Form))
        {
            // /States/{State} lands on the state's first form; replace so Back returns to the state picker.
            if (forms is { Count: > 0 })
            {
                Navigation.NavigateTo($"/States/{State}/{forms[0].Form}", replace: true);
            }

            return;
        }

        bool stateChanged = activeState is not null && !string.Equals(activeState, State, StringComparison.OrdinalIgnoreCase);
        activeState = State;

        bool switched = activeForm is not null && !string.Equals(activeForm, Form, StringComparison.OrdinalIgnoreCase);
        activeForm = Form;

        if (stateChanged)
        {
            // A different state means a different input shape - never carry one state's result
            // (or fire its request) across; the new state starts clean.
            errors.Clear();
            ClearResult();
            return;
        }

        if (switched)
        {
            errors.Clear();

            if (submitted && result is not null)
            {
                // Never leave one form's answer under another form's heading: recalculate for the new form
                // (or surface its validation message) using the figures already on screen.
                ClearResult();
                await CalculateAsync(persistParents: false);
            }
        }
    }

    private async Task LoadFormsAsync()
    {
        try
        {
            forms = await Http.GetFromJsonAsync<List<FormSummaryDto>>($"api/v1/states/{State}/forms");
        }
        catch
        {
            forms = new List<FormSummaryDto>();
            errors.Add("Could not load the forms for this state.");
        }
    }

    private async Task LoadSavedProfilesAsync()
    {
        try
        {
            savedProfiles = await Http.GetFromJsonAsync<List<ParentProfileDto>>("api/v1/parents");
        }
        catch
        {
            // Guests and users without saved profiles simply see an empty picker.
        }
    }

    private async Task CalculateAsync(bool persistParents = true)
    {
        if (calculating)
        {
            return;
        }

        errors.Clear();

        // Anything that stops a calculation also clears whatever result was on screen, so a stale
        // answer never sits under a validation message.
        if (string.IsNullOrEmpty(Form))
        {
            ClearResult();
            errors.Add("Select a form before calculating.");
            return;
        }

        if (RequiresPrimaryCustody && plaintiff.HasPrimaryCustody == defendant.HasPrimaryCustody)
        {
            ClearResult();
            errors.Add("For this form, you must mark exactly one parent as having Primary Custody.");
            return;
        }

        calculating = true;

        try
        {
            var request = new CalculationRequest
            {
                NumberOfChildren = numberOfChildren,
                Plaintiff = plaintiff,
                Defendant = defendant
            };

            HttpResponseMessage response;

            try
            {
                response = await Http.PostAsJsonAsync($"api/v1/states/{State}/forms/{Form}/calculations", request);
            }
            catch (HttpRequestException)
            {
                // Same rule as validation stops: nothing stale stays on screen (and Export, which
                // recalculates first, must not fall through on a result that failed to refresh).
                ClearResult();
                errors.Add(ApiUnreachableMessage);
                return;
            }

            if (!response.IsSuccessStatusCode)
            {
                errors.Add(response.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => "No calculator is registered for this state and form.",
                    System.Net.HttpStatusCode.BadRequest => "The submitted inputs were invalid. Check the values and try again.",
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please log in again.",
                    System.Net.HttpStatusCode.Forbidden => "You are not authorized to perform this calculation.",
                    _ => $"Calculation request failed ({(int)response.StatusCode})."
                });
                return;
            }

            result = await response.Content.ReadFromJsonAsync<CalculationResponse>();
            submitted = true;

            // Guests cannot save parents (the API answers 403), so never fire the doomed
            // write - a silently discarded failure would let a guest believe a name saved.
            if (persistParents && !isGuest && result is { Success: true })
            {
                await SaveParentsAsync();
            }
        }
        finally
        {
            calculating = false;
        }
    }

    private async Task ExportAsync()
    {
        if (exporting || !CanExport || string.IsNullOrEmpty(Form))
        {
            return;
        }

        exporting = true;

        try
        {
            // The inputs stay editable after a calculation, so recalculate first: the workbook must match
            // what is on screen, and a figure the calculator rejects must not reach the export.
            await CalculateAsync(persistParents: false);

            if (result is not { Success: true })
            {
                return;
            }

            var request = new WorksheetExportRequest
            {
                NumberOfChildren = numberOfChildren,
                Plaintiff = plaintiff,
                Defendant = defendant,
                PlaintiffName = plaintiffName,
                DefendantName = defendantName
            };

            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/v1/states/{State}/forms/{Form}/calculations/export/xlsx", request);

            if (!response.IsSuccessStatusCode)
            {
                errors.Add(response.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => "No worksheet export is available for this state and form.",
                    System.Net.HttpStatusCode.BadRequest => "The figures could not be exported. Calculate again and check the messages.",
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please log in again.",
                    System.Net.HttpStatusCode.Forbidden => "You are not authorized to export this worksheet.",
                    _ => $"Export request failed ({(int)response.StatusCode})."
                });
                return;
            }

            byte[] bytes = await response.Content.ReadAsByteArrayAsync();
            string fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                ?? $"FairShare_{State}_{Form}.xlsx";
            string contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";

            await JS.InvokeVoidAsync("fairshareDownload.saveFile", fileName, contentType, bytes);
        }
        catch (HttpRequestException)
        {
            errors.Add(ApiUnreachableMessage);
        }
        catch (JSException)
        {
            // The download helper lives in js/site.js; a browser still holding last release's copy has no
            // fairshareDownload. Say so inline rather than tripping Blazor's fatal "reload" banner.
            errors.Add(StaleClientMessage);
        }
        finally
        {
            exporting = false;
        }
    }

    private CalculationRequest BuildScenarioInputs() => new()
    {
        NumberOfChildren = numberOfChildren,
        Plaintiff = plaintiff,
        Defendant = defendant
    };

    private async Task ApplyScenarioAsync(FairShare.Contracts.Scenarios.ScenarioDetailDto detail)
    {
        numberOfChildren = detail.Inputs.NumberOfChildren is >= 1 and <= 6 ? detail.Inputs.NumberOfChildren : 1;
        plaintiff.ApplyFrom(detail.Inputs.Plaintiff);
        defendant.ApplyFrom(detail.Inputs.Defendant);
        await CalculateAsync(persistParents: false);
    }

    // A flipped Primary Custody switch mirrors onto the other parent (on -> other off, off -> other on).
    // Only switch clicks arrive here; loading a saved profile or clearing a card leaves the other alone.
    private void MirrorPrimaryCustody(ParentDataDto other, bool value)
    {
        other.HasPrimaryCustody = !value;
    }

    private async Task SaveParentsAsync()
    {
        bool saved = false;

        // The API upserts by name: re-saving an existing parent's name (edited or not)
        // updates that record in place rather than creating a same-named duplicate.
        if (!string.IsNullOrWhiteSpace(plaintiffName))
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/v1/parents", ToCreateRequest(plaintiffName, plaintiff));
            saved |= response.IsSuccessStatusCode;
        }

        if (!string.IsNullOrWhiteSpace(defendantName))
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/v1/parents", ToCreateRequest(defendantName, defendant));
            saved |= response.IsSuccessStatusCode;
        }

        if (saved)
        {
            // Keep the picker in sync with what was just written.
            await LoadSavedProfilesAsync();
        }
    }

    private static ParentProfileCreateRequest ToCreateRequest(string displayName, ParentDataDto data) => new()
    {
        DisplayName = displayName,
        MonthlyGrossIncome = data.MonthlyGrossIncome,
        PreexistingChildSupport = data.PreexistingChildSupport,
        PreexistingAlimony = data.PreexistingAlimony,
        WorkRelatedChildcareCosts = data.WorkRelatedChildcareCosts,
        HealthcareCoverageCosts = data.HealthcareCoverageCosts,
        HasPrimaryCustody = data.HasPrimaryCustody
    };

    private async Task ResetAsync()
    {
        // Reset is destructive with no undo, so confirm - but only when there is
        // something to lose, keeping the empty-form case one click.
        if (HasEnteredData && !await JS.InvokeAsync<bool>("confirm", "Clear all entered figures and results?"))
        {
            return;
        }

        numberOfChildren = 1;
        plaintiff.ApplyFrom(new ParentDataDto());
        defendant.ApplyFrom(new ParentDataDto());
        plaintiffName = null;
        defendantName = null;
        plaintiffSelectedProfileId = null;
        defendantSelectedProfileId = null;
        ClearResult();
        errors.Clear();
    }

    private bool HasEnteredData =>
        numberOfChildren != 1
        || HasFigures(plaintiff)
        || HasFigures(defendant)
        || !string.IsNullOrWhiteSpace(plaintiffName)
        || !string.IsNullOrWhiteSpace(defendantName)
        || submitted;

    private static bool HasFigures(ParentDataDto parent) =>
        parent.MonthlyGrossIncome != 0
        || parent.PreexistingChildSupport != 0
        || parent.PreexistingAlimony != 0
        || parent.WorkRelatedChildcareCosts != 0
        || parent.HealthcareCoverageCosts != 0
        || parent.HasPrimaryCustody;

    private void ClearResult()
    {
        result = null;
        submitted = false;
    }

    // "Defendant: John D. owes $50." when the paying parent has a name, "Defendant owes $50." when not.
    private string ResultSentence(CalculationResponse calculation)
    {
        if (string.IsNullOrWhiteSpace(calculation.Payer))
        {
            return "No net transfer.";
        }

        string? name = calculation.Payer.Equals("Plaintiff", StringComparison.OrdinalIgnoreCase) ? plaintiffName : defendantName;
        string who = string.IsNullOrWhiteSpace(name) ? calculation.Payer : $"{calculation.Payer}: {name.Trim()}";
        return $"{who} owes ${calculation.FinalAmount}.";
    }

    // The last line of the worksheet is the recommended order - the row a user reads first.
    private bool IsFinalLine(WorksheetLineDto line) => result is not null && ReferenceEquals(line, result.Lines[^1]);

    private static string FormatCell(WorksheetLineDto line, decimal? value)
    {
        if (value is null)
        {
            return string.Empty;
        }

        if (string.Equals(line.Format, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            return value.Value.ToString("P0");
        }

        return value.Value < 0
            ? $"-${Math.Abs(value.Value):N0}"
            : $"${value.Value:N0}";
    }
}
