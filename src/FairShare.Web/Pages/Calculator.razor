@page "/States/{State}/{Form?}"
@attribute [Authorize]
@using FairShare.Contracts.Calculation
@using FairShare.Contracts.Catalog
@using FairShare.Contracts.Parents
@inject HttpClient Http
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>FairShare - @State - @(CurrentForm?.DisplayName ?? Form) Calculator</PageTitle>

<div class="container my-4">
    <h1 class="h4 mb-3 text-center">@State - @(CurrentForm?.DisplayName ?? Form) Calculator</h1>

    @if (forms is null)
    {
        <p class="text-center text-muted">Loading forms...</p>
    }
    else if (!forms.Any())
    {
        <div class="alert alert-warning">No forms registered for this state.</div>
    }
    else
    {
        @* Plain navigation pills (each is a real link to the form's route), not a tab widget - so no tab roles.
           Manual active class on purpose: NavLink's prefix match would light up CS42 while on CS42S. *@
        <nav aria-label="Select form">
            <ul class="nav nav-pills nav-fill justify-content-center mb-2">
                @foreach (var f in forms)
                {
                    bool active = f.Form.Equals(Form, StringComparison.OrdinalIgnoreCase);
                    <li class="nav-item">
                        <a class="nav-link @(active ? "active" : "")"
                           aria-current="@(active ? "page" : null)"
                           href="@($"/States/{State}/{f.Form}")">@f.DisplayName</a>
                    </li>
                }
            </ul>
        </nav>
        @if (!string.IsNullOrWhiteSpace(CurrentForm?.Description))
        {
            <p class="text-muted small text-center mb-4">@CurrentForm.Description</p>
        }
    }

    <div class="row g-3 mb-4 justify-content-center">
        <div class="col-12 col-sm-5 col-lg-3 text-center">
            <label class="form-label" for="NumberOfChildren">Number of Children</label>
            <input type="number" id="NumberOfChildren" @bind="numberOfChildren" class="form-control" />
        </div>
    </div>

    @if (RequiresPrimaryCustody)
    {
        <div class="alert alert-info py-2 small text-center">
            Mark exactly one parent as having Primary Custody.
        </div>
    }

    <div class="row g-4">
        <ParentCard Title="Plaintiff"
                    Prefix="Plaintiff"
                    Data="plaintiff"
                    @bind-ParentName="plaintiffName"
                    ShowPrimary="RequiresPrimaryCustody"
                    SavedProfiles="savedProfiles" />

        <ParentCard Title="Defendant"
                    Prefix="Defendant"
                    Data="defendant"
                    @bind-ParentName="defendantName"
                    ShowPrimary="RequiresPrimaryCustody"
                    SavedProfiles="savedProfiles" />
    </div>

    <div class="mt-3 d-flex gap-2">
        <button class="btn btn-primary" @onclick="() => CalculateAsync()" disabled="@calculating">Calculate</button>
        <button class="btn btn-outline-secondary" @onclick="Reset">Reset</button>
        <button class="btn btn-outline-primary ms-auto"
                @onclick="ExportAsync"
                disabled="@(exporting || !CanExport)"
                title="Download the official worksheet with these figures filled in">
            @(exporting ? "Preparing..." : "Export to Excel")
        </button>
    </div>

    @if (errors.Any())
    {
        <div class="mt-3">
            <ul class="text-danger">
                @foreach (var error in errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <div class="mt-5">
        <div class="card shadow-sm">
            <div class="card-header text-center"><strong>Results</strong></div>
            <div class="card-body">
                @if (submitted && result is not null && result.Success)
                {
                    <p class="fw-bold text-center mb-0">
                        @(string.IsNullOrWhiteSpace(result.Payer)
                            ? "No net transfer."
                            : $"{result.Payer} owes ${result.FinalAmount}.")
                    </p>

                    @if (result.Lines.Any())
                    {
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-striped mb-0 worksheet-table">
                                <caption class="visually-hidden">@(CurrentForm?.DisplayName ?? Form) worksheet lines</caption>
                                <thead>
                                    <tr>
                                        <th scope="col">Line</th>
                                        <th scope="col">Item</th>
                                        <th scope="col" class="text-end">Plaintiff</th>
                                        <th scope="col" class="text-end">Defendant</th>
                                        <th scope="col" class="text-end">Combined</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var line in result.Lines)
                                    {
                                        <tr class="@(IsFinalLine(line) ? "table-primary fw-bold" : "")">
                                            <td>@line.Number</td>
                                            <td>@line.Label</td>
                                            <td class="text-end">@FormatCell(line, line.Plaintiff)</td>
                                            <td class="text-end">@FormatCell(line, line.Defendant)</td>
                                            <td class="text-end">@FormatCell(line, line.Combined)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
                else if (submitted && result is not null && !result.Success)
                {
                    <ul class="text-danger mb-0">
                        @foreach (var e in result.Errors)
                        {
                            <li>@e.Code: @e.Message</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted mb-0">Enter inputs and Calculate.</p>
                }
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a href="/" class="btn btn-link">&larr; Back to States</a>
    </div>
</div>

@code {
    [Parameter] public string State { get; set; } = string.Empty;
    [Parameter] public string? Form { get; set; }

    private int numberOfChildren;
    private readonly ParentDataDto plaintiff = new();
    private readonly ParentDataDto defendant = new();
    private string? plaintiffName;
    private string? defendantName;
    private CalculationResponse? result;
    private bool submitted;
    private bool calculating;
    private bool exporting;
    private List<ParentProfileDto>? savedProfiles;
    private readonly List<string> errors = new();

    private List<FormSummaryDto>? forms;
    private string? formsLoadedForState;
    private string? activeForm;

    private FormSummaryDto? CurrentForm =>
        forms?.FirstOrDefault(f => f.Form.Equals(Form, StringComparison.OrdinalIgnoreCase));

    // Export follows a successful calculation (and recalculates again right before exporting, see ExportAsync).
    private bool CanExport => submitted && result is { Success: true };

    // Until the catalog answers, fall back to the one form we know needs a custodial parent.
    private bool RequiresPrimaryCustody =>
        CurrentForm is { } current
            ? !current.IsSharedCustody
            : string.Equals(Form, "CS42", StringComparison.OrdinalIgnoreCase);

    protected override Task OnInitializedAsync() => LoadSavedProfilesAsync();

    // Switching forms navigates between URLs that resolve to this same component, so Blazor reuses the
    // instance and only this hook runs: the entered figures survive, and we decide what to do with the result.
    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(formsLoadedForState, State, StringComparison.OrdinalIgnoreCase))
        {
            formsLoadedForState = State;
            await LoadFormsAsync();
        }

        if (string.IsNullOrEmpty(Form))
        {
            // /States/{State} lands on the state's first form; replace so Back returns to the state picker.
            if (forms is { Count: > 0 })
            {
                Navigation.NavigateTo($"/States/{State}/{forms[0].Form}", replace: true);
            }

            return;
        }

        bool switched = activeForm is not null && !string.Equals(activeForm, Form, StringComparison.OrdinalIgnoreCase);
        activeForm = Form;

        if (switched)
        {
            errors.Clear();

            if (submitted && result is not null)
            {
                // Never leave one form's answer under another form's heading: recalculate for the new form
                // (or surface its validation message) using the figures already on screen.
                ClearResult();
                await CalculateAsync(persistParents: false);
            }
        }
    }

    private async Task LoadFormsAsync()
    {
        try
        {
            forms = await Http.GetFromJsonAsync<List<FormSummaryDto>>($"api/v1/states/{State}/forms");
        }
        catch
        {
            forms = new List<FormSummaryDto>();
            errors.Add("Could not load the forms for this state.");
        }
    }

    private async Task LoadSavedProfilesAsync()
    {
        try
        {
            savedProfiles = await Http.GetFromJsonAsync<List<ParentProfileDto>>("api/v1/parents");
        }
        catch
        {
            // Guests and users without saved profiles simply see an empty picker.
        }
    }

    private async Task CalculateAsync(bool persistParents = true)
    {
        if (calculating)
        {
            return;
        }

        errors.Clear();

        // Anything that stops a calculation also clears whatever result was on screen, so a stale
        // answer never sits under a validation message.
        if (string.IsNullOrEmpty(Form))
        {
            ClearResult();
            errors.Add("Select a form before calculating.");
            return;
        }

        if (RequiresPrimaryCustody && plaintiff.HasPrimaryCustody == defendant.HasPrimaryCustody)
        {
            ClearResult();
            errors.Add("For this form, you must mark exactly one parent as having Primary Custody.");
            return;
        }

        calculating = true;

        try
        {
            var request = new CalculationRequest
            {
                NumberOfChildren = numberOfChildren,
                Plaintiff = plaintiff,
                Defendant = defendant
            };

            HttpResponseMessage response = await Http.PostAsJsonAsync($"api/v1/states/{State}/forms/{Form}/calculations", request);

            if (!response.IsSuccessStatusCode)
            {
                errors.Add(response.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => "No calculator is registered for this state and form.",
                    System.Net.HttpStatusCode.BadRequest => "The submitted inputs were invalid. Check the values and try again.",
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please log in again.",
                    System.Net.HttpStatusCode.Forbidden => "You are not authorized to perform this calculation.",
                    _ => $"Calculation request failed ({(int)response.StatusCode})."
                });
                return;
            }

            result = await response.Content.ReadFromJsonAsync<CalculationResponse>();
            submitted = true;

            if (persistParents && result is { Success: true })
            {
                await SaveParentsAsync();
            }
        }
        finally
        {
            calculating = false;
        }
    }

    private async Task ExportAsync()
    {
        if (exporting || !CanExport || string.IsNullOrEmpty(Form))
        {
            return;
        }

        exporting = true;

        try
        {
            // The inputs stay editable after a calculation, so recalculate first: the workbook must match
            // what is on screen, and a figure the calculator rejects must not reach the export.
            await CalculateAsync(persistParents: false);

            if (result is not { Success: true })
            {
                return;
            }

            var request = new WorksheetExportRequest
            {
                NumberOfChildren = numberOfChildren,
                Plaintiff = plaintiff,
                Defendant = defendant,
                PlaintiffName = plaintiffName,
                DefendantName = defendantName
            };

            using HttpResponseMessage response = await Http.PostAsJsonAsync($"api/v1/states/{State}/forms/{Form}/calculations/export/xlsx", request);

            if (!response.IsSuccessStatusCode)
            {
                errors.Add(response.StatusCode switch
                {
                    System.Net.HttpStatusCode.NotFound => "No worksheet export is available for this state and form.",
                    System.Net.HttpStatusCode.BadRequest => "The figures could not be exported. Calculate again and check the messages.",
                    System.Net.HttpStatusCode.Unauthorized => "Your session has expired. Please log in again.",
                    System.Net.HttpStatusCode.Forbidden => "You are not authorized to export this worksheet.",
                    _ => $"Export request failed ({(int)response.StatusCode})."
                });
                return;
            }

            byte[] bytes = await response.Content.ReadAsByteArrayAsync();
            string fileName = response.Content.Headers.ContentDisposition?.FileNameStar
                ?? response.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                ?? $"FairShare_{State}_{Form}.xlsx";
            string contentType = response.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";

            await JS.InvokeVoidAsync("fairshareDownload.saveFile", fileName, contentType, bytes);
        }
        finally
        {
            exporting = false;
        }
    }

    private async Task SaveParentsAsync()
    {
        bool saved = false;

        // The API upserts by name: re-saving an existing parent's name (edited or not)
        // updates that record in place rather than creating a same-named duplicate.
        if (!string.IsNullOrWhiteSpace(plaintiffName))
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/v1/parents", ToCreateRequest(plaintiffName, plaintiff));
            saved |= response.IsSuccessStatusCode;
        }

        if (!string.IsNullOrWhiteSpace(defendantName))
        {
            using HttpResponseMessage response = await Http.PostAsJsonAsync("api/v1/parents", ToCreateRequest(defendantName, defendant));
            saved |= response.IsSuccessStatusCode;
        }

        if (saved)
        {
            // Keep the picker in sync with what was just written.
            await LoadSavedProfilesAsync();
        }
    }

    private static ParentProfileCreateRequest ToCreateRequest(string displayName, ParentDataDto data) => new()
    {
        DisplayName = displayName,
        MonthlyGrossIncome = data.MonthlyGrossIncome,
        PreexistingChildSupport = data.PreexistingChildSupport,
        PreexistingAlimony = data.PreexistingAlimony,
        WorkRelatedChildcareCosts = data.WorkRelatedChildcareCosts,
        HealthcareCoverageCosts = data.HealthcareCoverageCosts,
        HasPrimaryCustody = data.HasPrimaryCustody
    };

    private void Reset()
    {
        numberOfChildren = 0;
        plaintiff.ApplyFrom(new ParentDataDto());
        defendant.ApplyFrom(new ParentDataDto());
        plaintiffName = null;
        defendantName = null;
        ClearResult();
        errors.Clear();
    }

    private void ClearResult()
    {
        result = null;
        submitted = false;
    }

    // The last line of the worksheet is the recommended order - the row a user reads first.
    private bool IsFinalLine(WorksheetLineDto line) => result is not null && ReferenceEquals(line, result.Lines[^1]);

    private static string FormatCell(WorksheetLineDto line, decimal? value)
    {
        if (value is null)
        {
            return string.Empty;
        }

        if (string.Equals(line.Format, "Percent", StringComparison.OrdinalIgnoreCase))
        {
            return value.Value.ToString("P0");
        }

        return value.Value < 0
            ? $"-${Math.Abs(value.Value):N0}"
            : $"${value.Value:N0}";
    }
}
